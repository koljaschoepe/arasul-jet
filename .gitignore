# Arasul Platform - Git Ignore

# Environment files with secrets
.env
# Stern mit Absicht: Auf dem Geraet lag am 19.08.2026 eine
# `.env.bak-vor-import-2026-08-18` mit 16 Zeilen Passwoertern und Schluesseln,
# und `git check-ignore` sagte ausdruecklich: nicht ignoriert. Weder `.env.bak`
# noch `*.bak` noch `.env.backup.*` greifen bei so einem Namen. Ein `git add -A`
# haette die Datei committet.
.env.bak*
.env.local
.env.*.local
.env.jetson

# Data directories
/data/
/logs/
/cache/
/updates/

# System-generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
dist/
build/
coverage/
*.log

# Exception: shared package build outputs are checked in so Dockerfiles
# and downstream workspaces can consume without a build-stage bootstrap.
!packages/*/dist/

# Node modules
node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Docker volumes (local testing)
postgres_data/

# Temporary files
*.tmp
*.temp

# Secrets
*.pem
*.key
# Der private Lizenzschluessel (Auftrag J32): nie im Repo, nie am Geraet. Er
# liegt allein im macOS-Schluesselbund von Kolja (Konto arasul, Dienst
# 'Arasul Lizenz privat'). Ausdruecklich, obwohl `*.pem` ihn schon deckt --
# wer die Regel oben eines Tages lockert, soll hier stehen sehen, warum nicht.
private_license_key.pem
# Die oeffentliche Haelfte ist kein Geheimnis: sie gehoert ins Repo, ins
# Artefakt und ueber den Deploy auf jedes Geraet. Ohne sie prueft das Geraet
# keine Lizenz und bleibt community.
!config/public_license_key.pem
admin.hash
config/secrets/
!config/secrets/.example/
# Siebte Trennung des Pruefstands (compose/pruefstand.vars): eigene
# Geheimnisse, damit ein Werksreset dort nicht die echten anfasst.
config/secrets-pruefstand/
config/.traefik-credentials
config/certs/
# Device-specific self-signed TLS pair, generated per box by setup_https() in
# ./arasul. Never commit it (the matching *.key is already covered above).
config/traefik/certs/
config/ssh/

# Device-specific configuration (not versioned)
config/device/
config/profiles/
config/dev/

# Environment backups
.env.backup.*
*.backup
*.backup.*
*.bak

# Local tool configuration
.mcp.json
.claude/plans/
.claude/scheduled_tasks.lock
.claude/settings.local.json
config/base/

# MCP tool artifacts (ephemeral Playwright browser-session dumps)
.playwright-mcp/

# Test output artifacts
apps/*/jest-results.json
apps/*/test-results.json

# Pruefstand (Plan 023 B5): eigener Datentopf, nie eingecheckt
data-pruefstand/
logs-pruefstand/
.env.pruefstand
arasul-abnahme-sitzung.json
# Der geteilte Anmelde-Token der Abnahme-Reihe (Entscheidung 27.08.2026) und
# sein Keksglas. Beide sind gueltige Sitzungen des Geraets.
arasul-abnahme-token
arasul-abnahme-token.cookies
arasul-abnahme-code
