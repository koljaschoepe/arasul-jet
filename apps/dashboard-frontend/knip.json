{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/index.tsx", "index.html", "src/**/*.test.{ts,tsx}", "src/__tests__/**/*.{ts,tsx}"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "@arasul/shared-schemas",
    "@testing-library/dom",
    "eslint-plugin-react",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-plugin-jsx-a11y",
    "class-variance-authority",
    "clsx",
    "radix-ui",
    "tailwind-merge"
  ],
  "ignoreBinaries": ["eslint"]
}
