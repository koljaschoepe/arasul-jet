# Cloudflare Tunnel Konfiguration
#
# Kopiere diese Datei zu config.yml und passe die Werte an.
# Wird nur benoetigt, wenn du config-basierte Authentifizierung verwendest.
# Bei Token-basierter Auth (empfohlen, compose.external.yaml) nicht noetig.

tunnel: arasul-<kunde>
credentials-file: /etc/cloudflared/credentials.json

# Logging
loglevel: info

# Ingress-Regeln (von spezifisch zu allgemein)
ingress:
  # 1. Das Dashboard samt API ueber Traefik
  - hostname: ${PUBLIC_DOMAIN}
    service: http://reverse-proxy:80
    originRequest:
      noTLSVerify: true
      connectTimeout: 30s

  # Catch-all: Alles andere blockieren
  - service: http_status:404
