# =============================================================================
# Pruefstand: zweiter Stack auf demselben Geraet (Plan 023 B5)
#
# Heisst .vars und nicht .env: der pre-commit-Hook blockiert jede Datei auf
# .env, weil dort sonst Geheimnisse landen. Hier stehen nur Pfade, Ports und
# Praefixe, aber die Regel wird nicht aufgeweicht, sondern der Name geaendert.
# =============================================================================
# Zweck: Werksreset und Auslieferungszustand echt nachweisen, ohne den
# Arbeitsstand des Geraets anzufassen. Auf dem Orin liegen acht Flows, davon ist
# genau einer ein Testartefakt; die anderen sieben sind Arbeitsstand. Ein
# Werksreset auf dem laufenden Stack waere kein Nachweis, sondern ein Verlust.
#
# Getrennt wird an sechs Stellen:
#   1. Projektname (docker compose -p) trennt Netze und benannte Volumes.
#   2. CONTAINER_PREFIX trennt die Containernamen. Die sind global, nicht je
#      Projekt, und wuerden sonst kollidieren.
#   3. DATA_PATH und LOGS_PATH trennen die Bind-Mounts. Das ist die wichtigste
#      Trennung: ohne sie zeigt der Pruefstand auf dieselben echten Ordner
#      (data/flows, data/projects, data/extensions) und ein Werksreset dort
#      loescht den Arbeitsstand.
#   4. Die fuenf Host-Ports.
#   5. Die Adressbereiche der Netze.
#   6. Die .env-Datei. Der Werksreset schreibt in sie: bei "Auslieferungszustand"
#      entwertet er ADMIN_PASSWORD, damit bootstrap.js den alten Zugang nicht
#      wieder anlegt. Ohne eigene Datei traefe das den Normalbetrieb mit.
#
# Alle sechs sind im Compose mit Standardwerten hinterlegt, die den Normalbetrieb
# unveraendert lassen. Am 19.08.2026 gegengeprueft: `docker compose config`
# rendert vorher und nachher dieselbe Pruefsumme.

CONTAINER_PREFIX=pruef-
DATA_PATH=../data-pruefstand
LOGS_PATH=../logs-pruefstand

HTTP_PORT=8081
HTTPS_PORT=8443
# 8090 haelt auf diesem Geraet `jetcam`, ein fremdes Projekt. Beim Hochfahren
# am 23.08.2026 scheiterte der Pruefstand daran, und die Docker-Meldung
# ("Bind for 0.0.0.0:8090 failed") sagt zwar was, aber nicht wer. Die
# Vorabpruefung in `pruefstand.sh` nennt jetzt den Halter.
TRAEFIK_DASHBOARD_PORT=8092
MINIO_API_PORT=9010
# Der LLM-Dienst startet im Pruefstand nicht (siehe pruefstand.sh), der Port
# steht hier trotzdem: sonst waere es eine schlafende Kollision, sobald jemand
# den Stack einmal vollstaendig hochfaehrt.
LLM_API_PORT=11444

# Fuenfte Trennung, beim ersten Startversuch aufgefallen: die Netze tragen feste
# Adressbereiche (172.30.0.0/26 bis 172.30.0.192/26). Zwei Stacks mit denselben
# Bereichen scheitern mit "Pool overlaps with other one on this address space".
NETZ_BASIS=172.31.0

# Sechste Trennung. Die Datei legt pruefstand.sh beim Hochfahren als Kopie der
# echten .env an, falls sie fehlt. Sie ist bewusst nicht eingecheckt.
ENV_DATEI=../.env.pruefstand

# Siebte Trennung, am 23.08.2026 dazugekommen. Ohne sie teilen sich beide
# Stacks dieselben Geheimnisdateien, und der "Fabrikzustand" ist keiner:
# `admin_password` liegt auch im frischen Pruefstand, bootstrap.js legt daraus
# einen Administrator an, und die Frischgeraet-Abnahme findet ein Konto ab Werk
# vor. Dass das Entwerten in der .env dafuer nicht reicht, steht seit dem
# 19.08.2026 in bootstrap.js: dieselbe Zeichenkette kommt als Docker-Secret
# herein.
#
# Der Ordner entsteht beim Hochfahren als Kopie der echten Geheimnisse. Die
# Frischgeraet-Abnahme laesst daraus `admin_password` weg, die
# Werksreset-Abnahme braucht es (sie setzt ein Geraet MIT Konto zurueck).
SECRETS_PFAD=../config/secrets-pruefstand
